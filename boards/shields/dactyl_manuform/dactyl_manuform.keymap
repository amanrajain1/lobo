#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3





/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "Default";
            bindings = <
                                        &kp N3    &kp N4   &kp N5   &bt BT_CLR                                 &bt BT_CLR &kp N6    &kp N7  &kp N8    
           &kp ESC   &kp N1   &kp N2    &kp E    &kp R     &kp T    &trans                                     &trans     &kp Y     &kp U   &kp I      &kp N9    &kp N0   &kp GRAVE    
           &kp TAB   &kp Q    &kp W     &kp D    &kp F     &kp G    &trans                                     &trans     &kp H     &kp J   &kp K      &kp O     &kp P    &kp MINUS 
           &kp LCTRL &kp A    &kp S     &kp C    &kp V     &kp B    &trans       &kp LBKT           &kp RBKT   &trans     &kp N     &kp M   &kp COMMA  &kp L     &kp SEMI &kp SQT
           &kp LSHFT &kp Z    &kp X              &kp LGUI  &mo 1    &kp SPACE    &kp RET            &kp RET    &kp SPACE  &mo 2     &kp LGUI           &kp DOT   &kp FSLH &kp RSHFT      
   
                                                         
            >;
sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
        lower_layer {
            display-name = "Lower";
            bindings = <
                                        &kp N3    &kp N4   &kp N5   &trans                                     &trans     &kp N6    &kp N7  &kp N8    
           &kp ESC   &kp N1   &kp N2    &kp E    &kp R     &kp T    &trans                                     &trans     &kp Y     &kp U   &kp I      &kp N9    &kp N0   &kp GRAVE    
           &kp TAB   &kp Q    &kp W     &kp D    &kp F     &kp G    &trans                                     &trans     &kp H     &kp J   &kp K      &kp O     &kp P    &kp MINUS 
           &kp LCTRL &kp A    &kp S     &kp C    &kp V     &kp B    &trans       &kp LBKT           &kp RBKT   &trans     &kp N     &kp M   &kp COMMA  &kp L     &kp SEMI &kp SQT
           &kp LSHFT &kp Z    &kp X              &kp LGUI  &mo 1    &kp SPACE    &kp RET            &kp RET    &kp SPACE  &mo 2     &kp LGUI           &kp DOT   &kp FSLH &kp RSHFT 
            >;      
sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;};

        raise_layer {
            display-name = "Gaming";
            bindings = <
                                        &kp N3    &kp N4   &kp N5   &trans                                     &trans     &kp N6    &kp N7  &kp N8    
           &kp ESC   &kp N1   &kp N2    &kp E    &kp R     &kp T    &trans                                     &trans     &kp Y     &kp U   &kp I      &kp N9    &kp N0   &kp GRAVE    
           &kp TAB   &kp Q    &kp W     &kp D    &kp F     &kp G    &trans                                     &trans     &kp H     &kp J   &kp K      &kp O     &kp P    &kp MINUS 
           &kp LCTRL &kp A    &kp S     &kp C    &kp V     &kp B    &trans       &kp LBKT           &kp RBKT   &trans     &kp N     &kp M   &kp COMMA  &kp L     &kp SEMI &kp SQT
           &kp LSHFT &kp Z    &kp X              &kp LGUI  &mo 1    &kp SPACE    &kp RET            &kp RET    &kp SPACE  &mo 2     &kp LGUI           &kp DOT   &kp FSLH &kp RSHFT  
            >;
sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        
        adjust_layer {
            display-name = "Adjust";
            bindings = <
                                        &kp N3    &kp N4   &kp N5   &trans                                     &trans     &kp N6    &kp N7  &kp N8    
           &kp ESC   &kp N1   &kp N2    &kp E    &kp R     &kp T    &trans                                     &trans     &kp Y     &kp U   &kp I      &kp N9    &kp N0   &kp GRAVE    
           &kp TAB   &kp Q    &kp W     &kp D    &kp F     &kp G    &trans                                     &trans     &kp H     &kp J   &kp K      &kp O     &kp P    &kp MINUS 
           &kp LCTRL &kp A    &kp S     &kp C    &kp V     &kp B    &trans       &kp LBKT           &kp RBKT   &trans     &kp N     &kp M   &kp COMMA  &kp L     &kp SEMI &kp SQT
           &kp LSHFT &kp Z    &kp X              &kp LGUI  &mo 1    &kp SPACE    &kp RET            &kp RET    &kp SPACE  &mo 2     &kp LGUI           &kp DOT   &kp FSLH &kp RSHFT 
            >;
sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
